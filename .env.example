# Copy to .env for local runs. Never commit .env.
# In the cloud these go in GitHub Secrets (radar), Supabase secrets (functions) and Vercel env (web).

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI (Google AI Studio)
GEMINI_API_KEY=

# Job-search APIs
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
JOOBLE_API_KEY=

# Alerts
TELEGRAM_BOT_TOKEN=
DISCORD_NEWS_WEBHOOK_URL=

# Nimbus inbox (Gmail app password, not your normal password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Watchdog (healthchecks.io)
HEALTHCHECKS_PING_URL=
